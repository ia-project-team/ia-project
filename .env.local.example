# ============================================================
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.
#
#   cp .env.local.example .env.local
#
# .env.local → 로컬 전용 시크릿 (git 제외)
# 배포 시(Vercel 등)에는 대시보드 환경변수를 사용하세요.
# ============================================================

# [공식 모드] OPENAI_BASE_URL 을 비워두면 공식 OpenAI API 를 사용합니다.
#            → OPENAI_API_KEY 에 실제 키를 넣으세요.
#            → 생성 모델은 코드에서 gpt-5.6-luna로 고정합니다.
OPENAI_API_KEY=

# [프록시 모드] OAuth 프록시 서버(학교/팀 공용 등)를 통해 호출할 때.
#             OPENAI_BASE_URL 을 채우면 자동으로 프록시 모드로 전환됩니다.
#             프록시가 gpt-5.6-luna를 지원하는지 먼저 확인하세요.
#             이때 OPENAI_API_KEY 는 실제 값이 필요 없어 dummy 로 둡니다.
#             (자세한 연결 방법: docs/openai-oauth.md)
# OPENAI_API_KEY=dummy
# OPENAI_BASE_URL=http://127.0.0.1:10531/v1

# [Supabase] RAG 지식베이스(pgvector) 연결. 팀 공용 프로젝트 하나를 사용합니다.
#            URL: 대시보드 → Settings → Data API → Project URL
#            KEY: 대시보드 → Settings → API Keys → Secret keys (sb_secret_...)
#            secret 키는 관리자 권한 — 서버 전용, 절대 공개 금지.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# [Supabase Auth] 회원가입/로그인용 anon(publishable) 키.
#            KEY: 대시보드 → Settings → API Keys → anon public (또는 sb_publishable_...)
#            RLS 하에서만 동작하는 키로, secret 키와 달리 세션 인증에 사용한다.
SUPABASE_ANON_KEY=
