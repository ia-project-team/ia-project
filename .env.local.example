# ============================================================
# 이 파일을 복사해서 .env.local 을 만들고 값을 채우세요.
#
#   cp .env.local.example .env.local
#
# .env.local  → 로컬 전용 시크릿 (git 제외)
# .env        → 공통 기본값 (git에 올라감 · 시크릿 금지)
# 배포 시(Vercel 등)에는 대시보드 환경변수를 사용하세요.
# ============================================================


# ------------------------------------------------------------
# 1. IA 멀티턴 서비스 (본체)
# ------------------------------------------------------------
# [공식 모드] OPENAI_BASE_URL 을 비워두면 공식 OpenAI API 를 사용합니다.
#            → OPENAI_API_KEY 에 실제 키를 넣으세요.
OPENAI_API_KEY=
MULTITURN_MODEL=gpt-5.4-mini

# [프록시 모드] OAuth 프록시 서버(학교/팀 공용 등)를 통해 호출할 때.
#             OPENAI_BASE_URL 을 채우면 자동으로 프록시 모드로 전환됩니다.
#             이때 OPENAI_API_KEY 는 실제 값이 필요 없어 dummy 로 둡니다.
#             (자세한 연결 방법: docs/openai-oauth.md)
# OPENAI_API_KEY=dummy
# OPENAI_BASE_URL=http://127.0.0.1:10531/v1
# MULTITURN_MODEL=gpt-5.5


# ------------------------------------------------------------
# 2. Claude baseline
# ------------------------------------------------------------
# Claude baseline 실행 시에만 필요합니다.
# 비워두면 runAll.ts 가 자동으로 Claude baseline 을 건너뜁니다.
ANTHROPIC_API_KEY=
CLAUDE_BASELINE_MODEL=claude-sonnet-4-6


# ------------------------------------------------------------
# 3. Evaluation — 역할별 모델
# ------------------------------------------------------------
# 가상 의뢰인 연기 모델              (eval/runner/simulator.ts)
OPENAI_SIMULATOR_MODEL=gpt-5.4-mini

# GPT baseline 상담 모델             (eval/runner/baselines/gpt.ts)
OPENAI_BASELINE_MODEL=gpt-5.4-mini

# 체크리스트 채점용 LLM-as-Judge     (eval/runner/evaluator.ts)
OPENAI_JUDGE_MODEL=gpt-5.4-mini


# ------------------------------------------------------------
# 4. Evaluation — 실행 설정
# ------------------------------------------------------------
# IA API 서버 URL                    (eval/runner/ia.ts)
IA_API_URL=http://localhost:3000

# ↓ 아래는 아직 코드에서 읽지 않습니다 (TODO).
# EVAL_MAX_TURNS=12          # 대화당 최대 AI 응답 턴 수 (현재 12로 하드코딩)
# EVAL_REPEAT_COUNT=1        # Case×System 반복 횟수 (현재 1회만 지원)
# EVAL_CONCURRENCY=1         # 동시 실행 실험 수 (현재 순차 실행만 지원)
# EVAL_OUTPUT_DIR=eval/runner/results   # 결과 저장 경로 (현재 하드코딩)


# ------------------------------------------------------------
# 5. LangSmith (평가 추적 · 실행)
# ------------------------------------------------------------
# LangSmith 로 평가를 실행하고 Trace 를 기록합니다.
# 연결 방법(키 발급 · 데이터셋 준비 · 실행)은 docs/langsmith.md 참고.

# LangSmith API Key
LANGCHAIN_API_KEY=

# Trace 가 기록될 LangSmith 프로젝트 이름
LANGCHAIN_PROJECT=

# 평가에 사용할 Dataset 이름 (비우면 기본값 "ia-golden-set")
LANGSMITH_DATASET_NAME=ia-golden-set


# ------------------------------------------------------------
# 6. RAG — 미구현 (TODO)
# ------------------------------------------------------------
# 기존 16개 체크리스트 수집을 대체하지 않고, 추가 쟁점 탐지·근거 검색에 사용.
# Vector Store 구조 확정 후 연결 변수를 여기에 추가합니다.
# RAG_ENABLED=false
# RAG_EMBEDDING_MODEL=          # 검색 Query·문서 Chunk 임베딩 모델
# RAG_TOP_K=                    # 검색당 가져올 최대 Chunk 수
# RAG_SCORE_THRESHOLD=          # 유사도 기준값
