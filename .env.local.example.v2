# ────────────────────────────────────────────────────────────
# 이 파일을 복사해서 .env.local 파일을 만들고 값을 채워넣으세요.
#
# cp .env.local.example .env.local
#
# [env 파일 종류 안내]
# .env.local  → 로컬 전용 시크릿 (git 제외, 최고 우선순위)
# .env        → 공통 기본값 (git에 올라가므로 시크릿 절대 금지)
#
# 배포 시(Vercel 등)에는 대시보드의 환경변수 설정을 사용하고,
# .env.local은 로컬 개발 전용으로만 사용하세요.
# ────────────────────────────────────────────────────────────


# ============================================================
# 1. IA 멀티턴 서비스 (본체)
# ============================================================
# ────────────────────────────────────────────────────────────
# 공식 OpenAI API 모드 (기본)
#
# OPENAI_BASE_URL을 설정하지 않으면 공식 OpenAI API를 사용합니다.
# ────────────────────────────────────────────────────────────

# 공식 모드 사용 시: 실제 API 키 입력
# 프록시 모드 사용 시: 'dummy' 또는 임의의 문자열
OPENAI_API_KEY=

# IA 본체 멀티턴 호출에 사용하는 모델
MULTITURN_MODEL=gpt-5.4-mini

# ────────────────────────────────────────────────────────────
# OAuth 프록시 모드 (선택)
#
# 직접 OpenAI API Key를 사용하지 않고, OAuth 인증을 거친
# 중간 프록시 서버를 통해 OpenAI 모델을 호출할 때 사용합니다.
# 예: 학교 또는 팀 공용 프록시
#
# OPENAI_BASE_URL을 설정하면 자동으로 프록시 모드로 전환됩니다.
# 이 경우 OPENAI_API_KEY는 실제 값이 없어도 되므로 dummy로 설정합니다.
#
# [내부 동작 차이]
# 공식 모드:
# generateObject 사용 (OpenAI Responses API)
#
# 프록시 모드:
# generateText + JSON 파싱 사용 (Chat Completions API)
#
# 프록시가 Responses API를 완전히 지원하지 않을 수 있기 때문에
# 두 모드의 Structured Output 처리 방식이 다릅니다.
# ────────────────────────────────────────────────────────────

# OPENAI_API_KEY=dummy
# OPENAI_BASE_URL=http://127.0.0.1:10531/v1
# MULTITURN_MODEL=gpt-5.5


# ============================================================
# 2. 외부 LLM Provider — Claude baseline
# ============================================================
# Claude baseline 실행 시 필요합니다.
# Claude baseline을 실행하지 않는 경우 비워둘 수 있습니다.
# ANTHROPIC_API_KEY가 비어있으면 runAll.ts가 자동으로 Claude baseline을 스킵합니다.

ANTHROPIC_API_KEY=
CLAUDE_BASELINE_MODEL=claude-sonnet-4-6


# ============================================================
# 3. Evaluation — 역할별 모델 설정
# ============================================================

# Ground Truth를 바탕으로 가상 의뢰인을 연기하는 모델
# eval/runner/simulator.ts
OPENAI_SIMULATOR_MODEL=gpt-5.4-mini

# 일반적인 임대차 상담 프롬프트를 사용하는 GPT baseline 모델
# 프롬프트 효과를 비교하기 위해 MULTITURN_MODEL과 동일하게 설정합니다.
# eval/runner/baselines/gpt.ts
OPENAI_BASELINE_MODEL=gpt-5.4-mini

# Baseline 대화에서 16개 체크리스트 슬롯을 추출하는 LLM-as-Judge.
# IA의 collected와 동일한 기준으로 baseline을 채점하기 위함.
# eval/runner/evaluator.ts
OPENAI_JUDGE_MODEL=gpt-5.4-mini


# ============================================================
# 4. Evaluation — 실행 설정
# ============================================================

# IA API 서버 URL
# eval/runner/ia.ts
# 로컬 개발 환경 기본값: http://localhost:3000
IA_API_URL=http://localhost:3000

# ────────────────────────────────────────────────────────────
# 아래 변수들은 현재 코드에서 직접 읽지 않습니다.
# 본 평가 단계에서 코드 추가 후 사용 예정 (TODO).
# ────────────────────────────────────────────────────────────

# 한 대화에서 허용하는 최대 AI 응답 턴 수
# 현재 eval/runner/runExperiment.ts에 maxTurns: 12 하드코딩됨
# EVAL_MAX_TURNS=12

# 동일 Case × System 조합의 반복 실행 횟수
# 데모: 1, 본 평가: 5 권장 (Avg@5 측정)
# 현재 미구현 — runAll.ts는 1회만 지원
# EVAL_REPEAT_COUNT=1

# 동시에 실행할 실험 수
# API Rate Limit과 비용을 고려해 조정합니다.
# 현재 미구현 — runAll.ts는 순차 실행만 지원
# EVAL_CONCURRENCY=1

# 로컬 평가 결과 저장 위치
# 현재 eval/runner/results로 하드코딩됨
# EVAL_OUTPUT_DIR=eval/runner/results


# ============================================================
# 5. LangSmith — 미구현 (TODO)
# ============================================================
# LangSmith 통합은 아직 코드에 반영되지 않았습니다.
# 통합 완료 후 아래 변수들을 활성화하세요.

# true로 설정하면 LangSmith Trace를 전송합니다.
# API Key 없이 true로 설정하지 마세요.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Trace가 저장될 LangSmith Project 이름
# LANGSMITH_PROJECT=

# 여러 Workspace에 접근 가능한 API Key를 사용하는 경우에만 설정합니다.
# LANGSMITH_WORKSPACE_ID=

# LangSmith Cloud 기본 Endpoint를 사용한다면 설정하지 않아도 됩니다.
# 다른 리전 또는 Self-hosted 환경에서만 변경합니다.
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ────────────────────────────────────────────────────────────
# 아래 값은 LangSmith 공식 환경변수가 아니라,
# IA 평가 코드에서 Dataset과 Experiment를 관리하기 위한 프로젝트 설정입니다.
# ────────────────────────────────────────────────────────────

# 평가에 사용할 LangSmith Dataset 이름
# LANGSMITH_DATASET_NAME=

# Experiment 이름 앞에 붙일 Prefix
# 실제 실행 시 system, prompt version, 날짜 등을 조합해 이름을 생성합니다.
# LANGSMITH_EXPERIMENT_PREFIX=


# ============================================================
# 6. RAG — 미구현 (TODO)
# ============================================================
# RAG 기능은 기존 16개 체크리스트 수집을 대체하지 않고,
# 추가 쟁점 탐지와 관련 근거 검색에 사용합니다.
#
# Vector Store와 문서 적재 구조가 확정된 후
# 저장소 연결 환경변수를 이 영역에 추가합니다.

# RAG_ENABLED=false

# 검색 Query와 문서 Chunk를 임베딩할 모델
# RAG_EMBEDDING_MODEL=

# 한 번의 검색에서 가져올 최대 Chunk 수
# RAG_TOP_K=

# 유사도 기준값
# 사용하는 Vector Store의 점수 체계에 맞춰 구현 단계에서 조정합니다.
# RAG_SCORE_THRESHOLD=
